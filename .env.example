# Copy to .env (git-ignored) for local runs. Every setting is optional; the defaults are safe:
# dry-run, keyless rule-based analysis, built-in observe-only policy.

# --- cluster access ---------------------------------------------------------------------
GUARDIAN_BACKEND=kubernetes          # kubernetes | fake (built-in demo cluster, no kubeconfig needed)
# GUARDIAN_KUBECONFIG=/path/to/kubeconfig   # unset: in-cluster service account, then $KUBECONFIG / ~/.kube/config
# GUARDIAN_KUBE_CONTEXT=

# --- safety -----------------------------------------------------------------------------
GUARDIAN_DRY_RUN=true                # true: decide + audit, change nothing. Set to false to allow live restarts
# GUARDIAN_POLICY_FILE=examples/policy.demo.yaml   # unset: built-in policy, which permits no remediation
GUARDIAN_CONFIDENCE_THRESHOLD=0.6
GUARDIAN_COOLDOWN_SECONDS=600        # min gap between live restarts of one workload
GUARDIAN_REPEAT_WINDOW_SECONDS=3600  # restarted within this window and still broken -> escalate to a human
GUARDIAN_MAX_ACTIONS_PER_HOUR=5
GUARDIAN_MAX_DECISIONS_PER_POLL=3

# --- polling and storage ----------------------------------------------------------------
GUARDIAN_POLL_INTERVAL_SECONDS=900
GUARDIAN_DB_PATH=data/guardian.db

# --- analysis: rules (default, no keys) or any OpenAI-compatible endpoint ---------------
GUARDIAN_ANALYZER=rules              # rules | llm
# GUARDIAN_LLM_BASE_URL=https://api.openai.com/v1
# GUARDIAN_LLM_API_KEY=
# GUARDIAN_LLM_TRIAGE_MODEL=           # cheap, fast model
# GUARDIAN_LLM_DECISION_MODEL=         # stronger model

# --- optional integrations --------------------------------------------------------------
# GUARDIAN_DISCORD_WEBHOOK_URL=
# GUARDIAN_API_TOKEN=                  # when set, POST /api/poll requires "Authorization: Bearer <token>"

# --- server -----------------------------------------------------------------------------
GUARDIAN_HOST=0.0.0.0
GUARDIAN_PORT=8000
GUARDIAN_LOG_LEVEL=INFO
